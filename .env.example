# Choose ONE provider (both are OpenAI-compatible)

# --- Groq ---
API_KEY=your_groq_key_here
BASE_URL=https://api.groq.com/openai/v1
MODEL=openai/gpt-oss-120b

# --- xAI (Grok) ---
# API_KEY=your_xai_key_here
# BASE_URL=https://api.x.ai/v1
# MODEL=grok-3-mini

# Agent settings
MAX_TOOL_ROUNDS=5
MAX_HISTORY_MESSAGES=20

# Map services for plan_route (optional — free defaults are in src/config.py, no key needed)
# GEOCODE_URL=https://nominatim.openstreetmap.org/search
# ROUTE_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
# ELEVATION_URL=https://api.open-meteo.com/v1/elevation
